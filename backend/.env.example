# ============================================================================
# LensCode – Adaptive QuantaMed Backend Environment Configuration
# ============================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=False
APP_ENV=production

# Database Configuration (PostgreSQL 15+)
DATABASE_URL=postgresql://quantamed_user:secret_password@localhost:5432/quantamed_db

# Gemini LLM Provider (Optional - for grounded feature reasoning)
# Raw scans or patient names are NEVER transmitted. Only numerical features.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Default Inference Provider: RuleBasedSimulator | GeminiProvider | BackendProvider
DEFAULT_INFERENCE_PROVIDER=RuleBasedSimulator

# ABDM M3 Sandbox Credentials (Simulated Sandbox Profile)
ABDM_SANDBOX_CLIENT_ID=SBX_CLIENT_QM_2026
ABDM_SANDBOX_CLIENT_SECRET=SBX_SECRET_KEY_QM_2026
ABDM_GATEWAY_URL=https://dev.abdm.gov.in/gateway
ABDM_HIP_ID=HIP-QM-091002
ABDM_HIU_ID=HIU-QM-DELHI-01

# Healthcare Facility Metadata
FACILITY_NAME="QuantaMed Advanced Clinical Diagnostic Center (Autonomous)"
FACILITY_HFR_ID=IN091002
FACILITY_ADDRESS="NDHM Diagnostic Corridor, Institutional Area, New Delhi 110029, India"

# Cryptographic Salt & Ledger Hashing
